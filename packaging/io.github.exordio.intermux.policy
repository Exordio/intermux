<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>InterMux</vendor>
  <vendor_url>https://github.com/Exordio/intermux</vendor_url>
  <icon_name>intermux</icon_name>

  <action id="io.github.exordio.intermux.gui">
    <description>Run InterMux</description>
    <description xml:lang="ru">Запуск InterMux</description>
    <message>InterMux needs administrator rights to set up network namespaces and routing</message>
    <message xml:lang="ru">InterMux нужны права администратора для настройки сетевых пространств имён и маршрутизации</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/intermux-gui</annotate>
  </action>
</policyconfig>
